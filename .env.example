# Copy to .env and fill in. Never commit .env.

# From @BotFather. Leave empty to run the offline emulator instead of the real bot.
BOT_TOKEN=
# Your Telegram user ID(s), comma separated (ask @userinfobot). They get order alerts and /admin.
ADMIN_IDS=

# Telegram Payments provider token: @BotFather -> your bot -> Payments -> Stripe -> "Connect Stripe TEST".
# Test tokens look like 123456789:TEST:xxxx. Use the LIVE token only after Stripe activation.
PAYMENT_PROVIDER_TOKEN=
CURRENCY=EUR
# 1 = show the Stripe test card hint (4242 4242 4242 4242) at checkout
PAYMENTS_TEST=1
# Free standard shipping in Germany from this subtotal (cents)
FREE_SHIPPING_DE_CENTS=8000

SHOP_NAME=KIEZ Supply
DEFAULT_LANG=en
DB_PATH=data/store.db

# Optional: live order sync to Google Sheets via the Apps Script in apps_script.gs
SHEETS_WEBHOOK_URL=
SHEETS_SECRET=

# 1 = force the offline emulator even if BOT_TOKEN is set
TEST_MODE=0
